```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.class
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out
dist/
build/
target/

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
*.env.*

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo

# System files
.DS_Store
Thumbs.db

# Coverage and testing
.coverage
coverage/
htmlcov/
.mypy_cache/
.pytest_cache/

# Gradle
.gradle/
```